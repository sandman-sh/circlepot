# Copy to .env.local and fill in what you use. All values are optional.

# Attach an existing CirclePot deployment instead of deploying from the app.
VITE_CIRCLEPOT_ADDRESS=

# Enables the WalletConnect connector in the wallet chooser (https://cloud.walletconnect.com).
VITE_WALLETCONNECT_PROJECT_ID=

# Enables Sentry error reporting in production builds (https://sentry.io).
VITE_SENTRY_DSN=
